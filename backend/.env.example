# Server
PORT=5000
NODE_ENV=

# MongoDB
MONGO_URI=MONGODV_CONNECTION_STRING

# JWT
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=15d

# Google Gemini API
GEMINI_API_KEY=GOOGLE_GEMINI_APIKEY
GEMINI_MODEL=gemini-3.6-flash

# Python NLP Microservice (spaCy)
NLP_SERVICE_URL=http://localhost:5001

# Job Search API (e.g. RapidAPI JSearch, Adzuna, etc.)
JOB_API_KEY=
JOB_API_URL=https://jsearch.p.rapidapi.com/search-v2

# CORS
CLIENT_URL=http://localhost:5173

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
SMTP_EMAIL=
SMTP_PASSWORD=

# OTP Secret
OTP_SECRET=